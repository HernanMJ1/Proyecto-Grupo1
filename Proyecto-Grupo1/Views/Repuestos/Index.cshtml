@model IEnumerable<Repuesto>
@{ ViewData["Title"] = "Inventario de repuestos"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h3 mb-1">Inventario de repuestos</h1><p class="text-muted mb-0">Gestione los repuestos disponibles y sus proveedores.</p></div>
    <div class="d-flex gap-2"><a asp-controller="Proveedores" asp-action="Index" class="btn btn-outline-primary">Proveedores</a><a asp-action="Create" class="btn btn-primary">Nuevo repuesto</a></div>
</div>
@if (TempData["MensajeExito"] is string mensaje) { <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div> }
<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-8"><label for="busqueda" class="visually-hidden">Buscar</label><input id="busqueda" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Buscar por código o nombre" /></div>
            <div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
        </form>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Código</th><th>Nombre</th><th>Proveedor</th><th class="text-end">Stock</th><th class="text-end">Precio venta</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron repuestos.</td></tr> }
                @foreach (var item in Model) { <tr><td class="fw-semibold">@item.Codigo</td><td>@item.Nombre</td><td>@item.Proveedor?.Nombre</td><td class="text-end">@item.Stock</td><td class="text-end">@item.PrecioVenta.ToString("N2")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.IdRepuesto" class="btn btn-sm btn-outline-secondary">Detalles</a> <a asp-action="Edit" asp-route-id="@item.IdRepuesto" class="btn btn-sm btn-outline-primary">Editar</a></td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
