@model Repuesto
@{
    ViewData["Title"] = "Editar repuesto";
    ViewData["EtiquetaStock"] = "Stock actual";
}
<div class="card shadow-sm"><div class="card-header"><h1 class="h4 mb-0">Editar repuesto</h1></div><div class="card-body"><form asp-action="Edit" method="post"><input type="hidden" asp-for="IdRepuesto" /><partial name="_Form" model="Model" /><div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary">Guardar cambios</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
