@model Repuesto
@{ ViewData["Title"] = "Detalle del repuesto"; }
<div class="card shadow-sm"><div class="card-header d-flex justify-content-between align-items-center"><h1 class="h4 mb-0">Detalle del repuesto</h1><span class="badge bg-secondary">@Model.Codigo</span></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd><dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@(Model.Descripcion ?? "Sin descripción")</dd><dt class="col-sm-4">Proveedor</dt><dd class="col-sm-8">@Model.Proveedor?.Nombre</dd><dt class="col-sm-4">Stock</dt><dd class="col-sm-8">@Model.Stock</dd><dt class="col-sm-4">Stock mínimo</dt><dd class="col-sm-8">@Model.StockMinimo</dd><dt class="col-sm-4">Precio de compra</dt><dd class="col-sm-8">@Model.PrecioCompra.ToString("N2")</dd><dt class="col-sm-4">Precio de venta</dt><dd class="col-sm-8">@Model.PrecioVenta.ToString("N2")</dd></dl></div><div class="card-footer text-end"><a asp-action="Index" class="btn btn-outline-secondary">Volver</a> <a asp-action="Edit" asp-route-id="@Model.IdRepuesto" class="btn btn-primary">Editar</a></div></div>
