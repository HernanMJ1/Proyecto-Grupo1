@model IEnumerable<Proveedor>
@{ ViewData["Title"] = "Proveedores"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1 class="h3 mb-1">Proveedores</h1><p class="text-muted mb-0">Administre los proveedores del inventario.</p></div><div class="d-flex gap-2"><a asp-controller="Repuestos" asp-action="Index" class="btn btn-outline-secondary">Volver al inventario</a><a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a></div></div>
@if (TempData["MensajeExito"] is string mensaje) { <div class="alert alert-success alert-dismissible fade show" role="alert">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div> }
<div class="card shadow-sm"><div class="card-body"><form method="get" class="row g-2 mb-3"><div class="col-md-8"><label for="busqueda" class="visually-hidden">Buscar</label><input id="busqueda" name="busqueda" value="@ViewData["Busqueda"]" class="form-control" placeholder="Buscar por nombre" /></div><div class="col-md-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div></form><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No se encontraron proveedores.</td></tr> }
@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Nombre</td><td>@item.Telefono</td><td>@(item.Correo ?? "—")</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-outline-secondary">Detalles</a> <a asp-action="Edit" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-outline-primary">Editar</a></td></tr> }
</tbody></table></div></div></div>
