@model Proveedor
@{ ViewData["Title"] = "Detalle del proveedor"; }
<div class="card shadow-sm"><div class="card-header"><h1 class="h4 mb-0">Detalle del proveedor</h1></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd><dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@Model.Telefono</dd><dt class="col-sm-4">Correo electrónico</dt><dd class="col-sm-8">@(Model.Correo ?? "No registrado")</dd><dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@(Model.Direccion ?? "No registrada")</dd></dl></div><div class="card-footer text-end"><a asp-action="Index" class="btn btn-outline-secondary">Volver</a> <a asp-action="Edit" asp-route-id="@Model.IdProveedor" class="btn btn-primary">Editar</a></div></div>
