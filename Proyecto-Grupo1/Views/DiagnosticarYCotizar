@model Proyecto_Grupo1.ViewModels.DiagnosticoCostosViewModel

@{
    ViewData["Title"] = "Diagnóstico y Costos Estimados";
}

<div class="container mt-4">
    <h2 class="mb-3">Orden #@Model.OrdenId — Diagnóstico y Costos Estimados</h2>

    @if (TempData["GuardadoExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["GuardadoExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <form asp-action="DiagnosticarYCotizar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="OrdenId" />

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <strong>1. Registrar Diagnóstico Técnico</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="DiagnosticoTecnico" class="form-label"></label>
                    <textarea asp-for="DiagnosticoTecnico" class="form-control" rows="4"
                              placeholder="Describa el diagnóstico del hardware y la falla detectada..."></textarea>
                    <span asp-validation-for="DiagnosticoTecnico" class="text-danger"></span>
                </div>

                <div class="mb-0">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"
                              placeholder="Observaciones adicionales o riesgos de reparación (opcional)..."></textarea>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <strong>2. Costos de Reparación Estimados</strong>
                <button type="button" class="btn btn-light btn-sm" onclick="agregarRepuesto()">+ Agregar concepto</button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="tablaCostos">
                        <thead class="table-light">
                            <tr>
                                <th>Repuesto / Servicio</th>
                                <th style="width: 120px;">Cantidad</th>
                                <th style="width: 160px;">Precio Unit.</th>
                                <th style="width: 150px;">Subtotal</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Repuestos.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="text" name="Repuestos[@i].Concepto" value="@Model.Repuestos[i].Concepto" class="form-control" required />
                                    </td>
                                    <td>
                                        <input type="number" name="Repuestos[@i].Cantidad" value="@Model.Repuestos[i].Cantidad" min="1" class="form-control cant" oninput="recalcularTodo()" required />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" name="Repuestos[@i].PrecioUnitario" value="@Model.Repuestos[i].PrecioUnitario" min="0" class="form-control prec" oninput="recalcularTodo()" required />
                                    </td>
                                    <td class="text-end sub">0.00</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="quitarFila(this)">X</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-3">
                    <div class="col-md-5">
                        <div class="mb-2 row align-items-center">
                            <label asp-for="CostoManoObra" class="col-sm-6 col-form-label fw-bold"></label>
                            <div class="col-sm-6">
                                <input asp-for="CostoManoObra" type="number" step="0.01" min="0" id="manoObraInput"
                                       class="form-control text-end" oninput="recalcularTodo()" />
                            </div>
                        </div>
                        <div class="row align-items-center border-top pt-2">
                            <span class="col-sm-6 fw-bold fs-5">Total Estimado:</span>
                            <span class="col-sm-6 text-end fw-bold fs-5 text-success" id="totalEstimadoTexto">0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Guardar en el sistema</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let contadorFilas = @Model.Repuestos.Count;

        function agregarRepuesto() {
            const tbody = document.querySelector("#tablaCostos tbody");
            const fila = document.createElement("tr");
            fila.innerHTML = `
                <td><input type="text" name="Repuestos[${contadorFilas}].Concepto" class="form-control" placeholder="Ej: Disco SSD NVMe 500GB" required /></td>
                <td><input type="number" name="Repuestos[${contadorFilas}].Cantidad" value="1" min="1" class="form-control cant" oninput="recalcularTodo()" required /></td>
                <td><input type="number" step="0.01" name="Repuestos[${contadorFilas}].PrecioUnitario" value="0.00" min="0" class="form-control prec" oninput="recalcularTodo()" required /></td>
                <td class="text-end sub">0.00</td>
                <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm" onclick="quitarFila(this)">X</button></td>
            `;
            tbody.appendChild(fila);
            contadorFilas++;
            recalcularTodo();
        }

        function quitarFila(boton) {
            boton.closest("tr").remove();
            normalizarIndices();
            recalcularTodo();
        }

        function normalizarIndices() {
            const filas = document.querySelectorAll("#tablaCostos tbody tr");
            filas.forEach((fila, idx) => {
                fila.querySelectorAll("input").forEach(input => {
                    input.name = input.name.replace(/\[\d+\]/, `[${idx}]`);
                });
            });
            contadorFilas = filas.length;
        }

        function recalcularTodo() {
            let sumaItems = 0;
            document.querySelectorAll("#tablaCostos tbody tr").forEach(fila => {
                const cant = parseFloat(fila.querySelector(".cant")?.value) || 0;
                const prec = parseFloat(fila.querySelector(".prec")?.value) || 0;
                const subtotal = cant * prec;
                fila.querySelector(".sub").textContent = subtotal.toFixed(2);
                sumaItems += subtotal;
            });

            const manoObra = parseFloat(document.getElementById("manoObraInput")?.value) || 0;
            const total = sumaItems + manoObra;
            document.getElementById("totalEstimadoTexto").textContent = total.toFixed(2);
        }

        document.addEventListener("DOMContentLoaded", recalcularTodo);
    </script>
}
